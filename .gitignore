# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# stray local build/test artifacts from manual compiler testing
*.exe
*.out
*.obj
*.o
compile-error.txt
/test.cpp

# local archives and one-off source backups (not part of the app)
*.zip
*.backup

# release artefacts: the tarball built off the host and the candidate
# release it is unpacked into. These are build output, not source, and the
# tarball is ~160 MB, so they must never be committed.
# /release/ also keeps the deploy script's "clean working tree" check green
# while the archive waits in the working tree to be promoted.
/release/
/releases/

