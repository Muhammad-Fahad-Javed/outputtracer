# Copy to .env on the EC2 host. These are read when the process starts.
# Create a new Supabase project, then run supabase/migrations/0001_cloud_ide.sql.
#
# IMPORTANT: Next.js does not overwrite variables that already exist in the
# process environment. If PM2/ecosystem.config.js exports SITE_URL, editing
# .env alone has no effect — restart with `pm2 restart outputtracer --update-env`
# after changing the value in the place that actually supplies it.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional aliases, same values as above.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production site URL — the canonical public origin (no trailing slash).
# Used for absolute links built by the server (transactional email). Browser
# redirects use the request host instead (see src/lib/supabase/requestOrigin.ts),
# so a stale value here can no longer redirect users to another domain.
# MUST be https://outputtracer.com in production.
SITE_URL=https://outputtracer.com

# Optional alias. Only needed for local development if you want Supabase
# confirmation emails to point at a tunnel/localhost.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Version-skew protection. Set to the release tag or git SHA at BUILD time.
# Next persists it in .next/required-server-files.json, but keep the same
# value in the running environment so a rebuild cannot drift from it.
# NEXT_DEPLOYMENT_ID=git-sha-or-release-tag

# Build output directory. Defaults to ".next", which is what the running
# server serves. Set it only for a candidate build: scripts/deploy-production.sh
# builds into ".next-candidate" so the live release is never overwritten by a
# build in progress, and its own cache directory (.next-candidate/cache) keeps
# the Turbopack cache and the TypeScript .tsbuildinfo of the live release
# undisturbed.
# The live server must run WITHOUT this variable: the deploy script promotes
# the candidate by renaming it to ".next".
# NEXT_DIST_DIR=.next-candidate

# Set to 1 only when the app is behind a trusted reverse proxy (Nginx/ALB).
# Enables X-Forwarded-For based rate limiting.
# TRUST_PROXY=1

# --- Cloudflare Turnstile (Supabase verifies the token server-side) ----------
# Site key is public and baked into the client bundle at build time.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=


# --- Execution sandbox (optional; sensible defaults apply) -------------------
# Compiler and GDB binaries.
# CXX_COMPILER=g++
# GDB_PATH=gdb
#
# Extra WebSocket origins allowed to connect (comma-separated). outputtracer.com
# is always allowed; localhost is allowed automatically in development.
# WS_ALLOWED_ORIGINS=https://staging.outputtracer.com
#
# Resource limits (defaults shown).
# MAX_MEMORY_MB=256
# MAX_CPU_SECONDS=5
# MAX_PROCESSES=32
# COMPILE_MAX_MEMORY_MB=1024
# TRACE_MAX_MEMORY_MB=1024
# MAX_STDIN_BYTES=65536
# MAX_WS_STDIN_MESSAGE_BYTES=8192
# WS_MAX_PAYLOAD_BYTES=1048576
#
# Tracing: set ENABLE_TRACE=0 to disable GDB tracing entirely.
# Unsandboxed execution is OFF by default and can NEVER be enabled in
# production. These two flags are DEVELOPMENT ONLY escape hatches for hosts
# without bubblewrap/prlimit (they run student code with no isolation):
#   ALLOW_UNSANDBOXED_EXECUTION=1  -> allow compile/run with no isolation
#   TRACE_ALLOW_UNSANDBOXED=1      -> allow tracing with no isolation
# ENABLE_TRACE=1
# ALLOW_UNSANDBOXED_EXECUTION=0
# TRACE_ALLOW_UNSANDBOXED=0

# --- Platform Administration & Roles ------------------------------------------
# Comma-separated list of Supabase user UUIDs granted platform administrator role.
# ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000

# --- Email Notifications (Resend API) -----------------------------------------
# Optional. If omitted, transactional emails gracefully fallback to simulated local delivery.
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=OutputTracer <noreply@outputtracer.com>
# Target email for new educator verification submissions.
# PLATFORM_OWNER_EMAIL=owner@outputtracer.com

# --- Classroom execution -----------------------------------------------------
# Optional external sandbox used for classroom assignment execution. It must
# be reachable only from this host (private network / security group): the
# endpoint runs untrusted code and does not authenticate callers itself.
# SANDBOX_EXECUTION_URL=https://sandbox.internal/run
#
# Override for the internal fallback used when SANDBOX_EXECUTION_URL is unset.
# Defaults to http://127.0.0.1:$PORT, which is always this process.
# INTERNAL_BASE_URL=http://127.0.0.1:3000

# --- CI test tooling ---------------------------------------------------------
# Makes sandbox integration tests fail (instead of skip) when bubblewrap or
# prlimit are unavailable. Do NOT set this on the production host.
# REQUIRE_SANDBOX_TOOLS=1

# --- Python 3 Sandbox Worker Service -----------------------------------------
# Optional absolute path to the python3 binary used by the local executor.
# PYTHON_PATH=/usr/bin/python3
# Set to true to enable Python 3 execution and step-by-step tracing endpoints.
# PYTHON_EXECUTION_ENABLED=true
# URL of the sandbox worker service (sandbox-worker/server.mjs running on sandbox host).
# PYTHON_SANDBOX_URL=http://localhost:4000
# Shared secret bearer token (minimum 32 characters) between Next.js and sandbox worker.
# PYTHON_SANDBOX_TOKEN=your-random-32-character-secret-token-here


# Opt-in browser push (generate VAPID keys on a trusted host; private key stays server-side).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@outputtracer.com
# DISABLE_BACKGROUND_JOBS=1 # use on staging/candidate servers that must not deliver live notifications
