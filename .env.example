# Copy to .env on the EC2 host. These are read when the container starts.
# Create a new Supabase project, then run supabase/migrations/0001_cloud_ide.sql.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional aliases, same values as above.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production site URL — used as the base for auth redirect URLs
# (emailRedirectTo, OAuth redirectTo). On the live server this is read from
# window.location.origin, so this variable is only needed for local dev when
# you want Supabase confirmation emails to point somewhere testable.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Execution sandbox (optional; sensible defaults apply) -------------------
# Compiler and GDB binaries.
# CXX_COMPILER=g++
# GDB_PATH=gdb
#
# Extra WebSocket origins allowed to connect (comma-separated). outputtracer.com
# is always allowed; localhost is allowed automatically in development.
# WS_ALLOWED_ORIGINS=https://staging.outputtracer.com
#
# Resource limits (defaults shown).
# MAX_MEMORY_MB=256
# MAX_CPU_SECONDS=5
# MAX_PROCESSES=32
# COMPILE_MAX_MEMORY_MB=1024
# TRACE_MAX_MEMORY_MB=1024
# MAX_STDIN_BYTES=65536
# MAX_WS_STDIN_MESSAGE_BYTES=8192
# WS_MAX_PAYLOAD_BYTES=1048576
#
# Tracing: set ENABLE_TRACE=0 to disable GDB tracing entirely.
# Unsandboxed execution is OFF by default and can NEVER be enabled in
# production. These two flags are DEVELOPMENT ONLY escape hatches for hosts
# without bubblewrap/prlimit (they run student code with no isolation):
#   ALLOW_UNSANDBOXED_EXECUTION=1  -> allow compile/run with no isolation
#   TRACE_ALLOW_UNSANDBOXED=1      -> allow tracing with no isolation
# ENABLE_TRACE=1
# ALLOW_UNSANDBOXED_EXECUTION=0
# TRACE_ALLOW_UNSANDBOXED=0
