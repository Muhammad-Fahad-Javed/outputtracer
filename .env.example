# Copy to .env on the EC2 host. These are read when the container starts.
# Create a new Supabase project, then run supabase/migrations/0001_cloud_ide.sql.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional aliases, same values as above.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production site URL — used as the base for auth redirect URLs
# (emailRedirectTo, OAuth redirectTo). On the live server this is read from
# window.location.origin, so this variable is only needed for local dev when
# you want Supabase confirmation emails to point somewhere testable.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
